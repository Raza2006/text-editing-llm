# Settings you may change. After a change run: textedit restart
WEBUI_NAME=Lab Paper Assistant
HTTPS_PORT=443
HTTP_PORT=80
# Conversations the model works on at the same moment
PARALLEL=8
# Shared context pool sizes to try, largest first (tokens)
CTX_CANDIDATES=524288 458752 393216 327680 262144
# Largest single conversation (the model's own maximum)
CTX_MAX_PER_CHAT=262144
# Compress a chat when it reaches this fraction of its limit
COMPRESS_AT=0.9
# GPU memory (MiB) that must stay free after the model has loaded
MIN_FREE_MIB=2048
# GPUs with less memory than this (MiB) use the smaller fallback model
MIN_VRAM_PRIMARY_MIB=40960
# Nightly database backups: how many to keep, and the hour they run
BACKUP_KEEP=14
BACKUP_HOUR=3
